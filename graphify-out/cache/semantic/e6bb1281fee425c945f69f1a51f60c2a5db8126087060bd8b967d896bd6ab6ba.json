{"nodes": [{"id": "references_evidence_kernel_layer", "label": "Evidence Kernel (evidence-proof layer)", "file_type": "concept", "source_file": "references/evidence-kernel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns four failure modes \u2014 fabricated quote, invented source, stale evidence, tampered snapshot \u2014 from 'hopefully caught in review' into 'mechanically rejected'."}, {"id": "references_evidence_kernel_agent_text_never_evidence", "label": "Agent-Written Text Is Never Evidence", "file_type": "rationale", "source_file": "references/evidence-kernel.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent may say what it concluded and where it read it, but may not supply the reading. Quotation marks and page numbers are free and survive review because nobody re-opens the PDF; excerpts are therefore re-sliced by script twice, at assembly and at publish."}, {"id": "references_evidence_kernel_snapshot_store", "label": "Immutable Snapshot Store", "file_type": "concept", "source_file": "references/evidence-kernel.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write-once via O_EXCL with content-addressed ids and an independent body hash; text is stored decoded-UTF-8 and never normalized so offsets under an existing claim never drift. PDFs are not duplicated \u2014 the snapshot records a wiki-root-relative asset path instead."}, {"id": "references_evidence_kernel_fresh_fetch_rule", "label": "Fresh-Fetch Rule", "file_type": "rationale", "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A supported verdict counts only if every backing source has a fetch or local_pdf event in this run with a hash that still matches. Register events, read events, cache-only fetches, cross-run events, search snippets and existing wiki notes deliberately do not count."}, {"id": "references_evidence_kernel_user_pdf_exception", "label": "User-Supplied-PDF Freshness Exception", "file_type": "rationale", "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For origin user-supplied-pdf there is nothing to re-fetch and possibly no lawful URL, so the immutable hash-checked local file is the fresh source. The exception exists because a user handing over a PDF is a real acquisition route, not because retrieval rules are negotiable."}, {"id": "references_evidence_kernel_span_contract", "label": "Claim Span Contract", "file_type": "concept", "source_file": "references/evidence-kernel.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "start inclusive, end exclusive, character offsets into the snapshot's decoded text (Unicode code points, not bytes) \u2014 the single ambiguity most likely to produce silent plausible-looking corruption, so it is closed explicitly. Max 2000 chars; over-length is a failure, never a truncation."}, {"id": "references_evidence_kernel_assembler_gate", "label": "Assembler Gate", "file_type": "concept", "source_file": "references/evidence-kernel.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derives URLs, excerpts, sections, pages and paper ids from snapshots, never from agent output; where the two disagree the snapshot wins and the artifact is rejected rather than silently corrected, because a silent correction hides that an agent asserted something false."}, {"id": "references_evidence_kernel_gate_default_off", "label": "Evidence-Kernel Gate Default Off", "file_type": "rationale", "source_file": "references/evidence-kernel.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gate is built, wired and always reported but non-blocking until a live end-to-end run passes, so rollout risk does not silently reduce reporting. Tamper failures (C-SNAPSHOT, C-SPAN) block promotion regardless \u2014 that is not a rollout concern."}, {"id": "references_evidence_kernel_publisher_preflight", "label": "Publisher Integrity Preflight (okf.py promote --check)", "file_type": "concept", "source_file": "references/evidence-kernel.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-reads snapshots, recomputes hashes and re-slices every excerpt a second time before any concept file is created. Promotion fails closed \u2014 never a partial bundle \u2014 while run outputs, report.md above all, are preserved."}], "edges": [{"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_agent_text_never_evidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_snapshot_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_fresh_fetch_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_span_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_assembler_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_evidence_kernel_publisher_preflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "references_evidence_kernel_fresh_fetch_rule", "target": "references_evidence_kernel_user_pdf_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "references_evidence_kernel_user_pdf_exception", "target": "deep_research_skill_quarantine_inbox_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "references_evidence_kernel_assembler_gate", "target": "references_evidence_kernel_gate_default_off", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "references_evidence_kernel_assembler_gate", "target": "references_evidence_kernel_span_contract", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "references_evidence_kernel_publisher_preflight", "target": "references_okf_bundle_validation_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "references_evidence_kernel_span_contract", "target": "references_schema_resolutions", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "\u00a74 (R10, R16-R18)", "weight": 1.0}, {"source": "references_evidence_kernel_layer", "target": "references_schema_index", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md", "source_location": "header", "weight": 1.0}, {"source": "references_evidence_kernel_fresh_fetch_rule", "target": "deep_research_skill_invariants", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "references/evidence-kernel.md", "source_location": "\u00a73", "weight": 1.0}], "hyperedges": [{"id": "evidence_proof_chain", "label": "Snapshot-to-Concept Evidence Proof Chain", "nodes": ["references_evidence_kernel_snapshot_store", "references_evidence_kernel_span_contract", "references_evidence_kernel_fresh_fetch_rule", "references_evidence_kernel_assembler_gate", "references_evidence_kernel_publisher_preflight", "prompts_extract_evidence_is_an_offset", "prompts_appraise_span_required_for_judgement"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/evidence-kernel.md"}]}