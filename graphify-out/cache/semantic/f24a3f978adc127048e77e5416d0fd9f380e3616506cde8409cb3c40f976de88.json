{"nodes": [{"id": "deep_research_skill_coordinator", "label": "deep-research Coordinator Skill", "file_type": "document", "source_file": "SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deep_research_skill_profiles", "label": "Run Profiles (fast/standard/systematic/max)", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Stage 0 \u2014 Profiles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles scope, rigor, gates and max_articles into one user-facing choice so Stage 0 asks one question instead of four; every field remains individually overridable in config.json."}, {"id": "deep_research_skill_scope_tiers", "label": "Scope Tiers (narrow/medium/wide/max)", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Stage 0 \u2014 Scope tiers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deep_research_skill_connector_preflight", "label": "Connector Preflight", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Stage 0 \u2014 Connector preflight", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool availability is a property of the session, not the skill: MCP servers attach at session start, so a claim about connectivity carries an expiry date and must never be copied across sessions or baked into the skill file. A max run without Scholar Gateway and Consensus is wide with extra steps and must say so rather than quietly returning less."}, {"id": "deep_research_skill_run_directory", "label": "Run Directory Layout", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Stage 0 \u2014 Run directory", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved directories hold exactly one record shape each because corpus.py reads every *.json in them as a record of that stage's type; a stray file of the wrong shape used to crash prisma/screen-ingest with a bare AttributeError."}, {"id": "deep_research_skill_stage_pointer", "label": "Stage Pointer", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Stage 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config.json's stage field is the only thing a resume trusts; a coordinator that carries the stage in its head leaves the pointer stale and sends the next session back to a stage already done."}, {"id": "deep_research_skill_pipeline", "label": "Eight-Stage Pipeline", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Pipeline", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deep_research_skill_delegation_rules", "label": "Bounded-Subagent Delegation Rules", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Delegation rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagents get bounded inputs and return only a one-line receipt so main context stays small over a long run; they write their own result files and the coordinator reads from disk. Subagents cannot spawn subagents."}, {"id": "deep_research_skill_shell_hygiene", "label": "Subagent Shell Hygiene (never ls)", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Delegation rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user alias mapping ls to eza hung indefinitely on an iCloud-backed run directory and wedged a subagent's shell for 45 minutes after its work had finished; the agent still returned its receipt, so the run looked clean while the process lingered at 0% CPU. Verify with find or a python3 one-liner instead."}, {"id": "deep_research_skill_taskboard", "label": "Task Board (taskboard.jsonl)", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Task board", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hand-edited; corpus.py task is its only writer so inputs_hash and timestamps stay computed. Resume is by task, not by stage, and completed outputs are immutable unless inputs_hash changes."}, {"id": "deep_research_skill_no_progress_guard", "label": "No-Progress Guard", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Execution guardrails", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every recording call appends a probe, so polling the guard while a run is legitimately parked manufactures the flat window it looks for; --no-record exists for status checks, and an empty board now reports idle rather than a stall."}, {"id": "deep_research_skill_health_alerts", "label": "Health Alerts (degraded runs must be announced)", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Health alerts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A degraded run looks exactly like a healthy one unless the coordinator says otherwise; silence is a bug, not tact. Never report a stage complete when part of it silently did not run, and treat an empty result as a finding rather than widening the query until the number looks respectable."}, {"id": "deep_research_skill_invariants", "label": "Non-Negotiable Invariants", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Invariants", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deep_research_skill_no_paywall_circumvention", "label": "No Paywall Circumvention (fail closed)", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Invariants #9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No credentials, no browser automation for access, no pirate mirrors. The OA ladder is the whole ladder. A missing paper is an honest gap in the report; a circumvented paywall is a policy breach."}, {"id": "deep_research_skill_quarantine_inbox_loop", "label": "Quarantine \u2192 Inbox \u2192 Resume Loop", "file_type": "concept", "source_file": "SKILL.md", "source_location": "Quarantine \u2192 inbox \u2192 resume loop", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The run never stalls on an unobtainable paper: it quarantines, keeps going, marks the synthesis provisional, and hands the human a list with direct links so they can supply the PDF themselves."}, {"id": "deep_research_skill_wiki_boundary", "label": "Wiki Boundary (research/ owned, wiki/ never written)", "file_type": "rationale", "source_file": "SKILL.md", "source_location": "Invariants #12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "<wiki>/wiki/ belongs to wiki-manager (OKF 0.1) and is never written to; deep-research owns <wiki>/research/ (OKF 0.2-style). The two bundles are format-incompatible on purpose."}], "edges": [{"source": "deep_research_skill_coordinator", "target": "references_schema_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILL.md", "source_location": "router table", "weight": 1.0}, {"source": "deep_research_skill_coordinator", "target": "references_search_strategy_manual", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILL.md", "source_location": "router table", "weight": 1.0}, {"source": "deep_research_skill_coordinator", "target": "references_acquisition_fulltext_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILL.md", "source_location": "Stage 4", "weight": 1.0}, {"source": "deep_research_skill_coordinator", "target": "references_appraisal_tool_selection", "relation": "references", "confidence