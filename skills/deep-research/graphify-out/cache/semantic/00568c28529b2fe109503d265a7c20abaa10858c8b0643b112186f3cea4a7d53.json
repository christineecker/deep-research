{"nodes": [{"id": "references_okf_bundle_spec", "label": "OKF 0.2 Bundle Frontmatter Spec", "file_type": "document", "source_file": "references/okf-bundle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An OKF-style convention owned by deep-research, not wiki-manager's OKF 0.1 and not an external standard; consumers must tolerate unknown concept types (open-world rule)."}, {"id": "references_okf_bundle_boundary_rules", "label": "Bundle Boundary Rules B1-B5", "file_type": "rationale", "source_file": "references/okf-bundle.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two bundles are format-incompatible on purpose so frontmatter is never copied between them; a research/ tree without a conforming root is not a deep-research bundle and okf.py initializes rather than writing into an unmarked tree."}, {"id": "references_okf_bundle_taxonomy", "label": "Concept Taxonomy and Paths", "file_type": "concept", "source_file": "references/okf-bundle.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paths are durable: stable concepts never live under a run directory, so knowledge outlives the run that produced it."}, {"id": "references_okf_bundle_pubmed_block", "label": "PubMed Bibliographic Frontmatter Block", "file_type": "concept", "source_file": "references/okf-bundle.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pmid, doi, pmcid, volume, issue and pages are always quoted strings so YAML never coerces a volume like '07' into an integer; fields are populated from corpus.jsonl and PubMed only, nothing fabricated to fill a slot."}, {"id": "references_okf_bundle_per_claim_attribution", "label": "Per-Claim Footnote Attribution", "file_type": "rationale", "source_file": "references/okf-bundle.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every evidence-bearing statement carries a markdown footnote keyed to a sources[].id; a body-only References list is not acceptable attribution because it lets a claim float free of its source."}, {"id": "references_okf_bundle_link_rules", "label": "Markdown Links as the Graph Layer", "file_type": "rationale", "source_file": "references/okf-bundle.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard markdown links carry every bundle-internal edge; Obsidian wikilinks are additive only, and a concept whose only link to a target is a wikilink is treated as unlinked so the graph stays tool-independent."}, {"id": "references_okf_bundle_validation_rules", "label": "OKF Validation Rules V1-V25", "file_type": "concept", "source_file": "references/okf-bundle.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each rule is machine-checkable; any violation keeps the report but blocks wiki promotion and writes outputs/okf-validation.md."}, {"id": "references_okf_bundle_log_convention", "label": "log.md Append Convention", "file_type": "concept", "source_file": "references/okf-bundle.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ISO date headings, newest last, append-only \u2014 prior entries are never reordered or rewritten so the log is an audit trail rather than a summary."}], "edges": [{"source": "deep_research_skill_wiki_boundary", "target": "references_okf_bundle_boundary_rules", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/okf-bundle.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "references_okf_bundle_spec", "targe