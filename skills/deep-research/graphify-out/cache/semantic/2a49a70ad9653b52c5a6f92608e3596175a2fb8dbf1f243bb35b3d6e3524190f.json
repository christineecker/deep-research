{"nodes": [{"id": "references_appraisal", "label": "appraisal.md \u2014 critical appraisal manual", "file_type": "document", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_appraisal_rob2", "label": "RoB 2 (Risk of Bias 2) \u2014 randomized trials", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_appraisal_robins_i", "label": "ROBINS-I \u2014 non-randomized intervention studies", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Judges a study against the hypothetical randomized 'target trial' it emulates, so bias is assessed as a deviation from that trial rather than against an abstract quality bar; overall judgement is the worst domain with no averaging so a single critical domain excludes the study from effect synthesis."}, {"id": "references_appraisal_newcastle_ottawa", "label": "Newcastle-Ottawa Scale \u2014 cohort/case-control", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_appraisal_amstar2", "label": "AMSTAR-2 \u2014 systematic reviews", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_appraisal_quadas2", "label": "QUADAS-2 \u2014 diagnostic accuracy", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately keeps risk of bias and applicability separate per domain instead of a single score, so a reader is never handed a false single number implying low applicability concern just because risk of bias is low."}, {"id": "references_appraisal_probast", "label": "PROBAST \u2014 prediction models", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appraises one model, not one paper: a development study and a validation study of the same model get separate appraisal records because their analysis-domain concerns (predictor selection/overfitting vs. recalibration) genuinely differ."}, {"id": "references_appraisal_casp_qualitative", "label": "CASP qualitative checklist \u2014 qualitative studies", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports a count out of 10 rather than a risk-of-bias label because CASP measures conduct/reporting transparency, not whether findings are well-grounded in the data \u2014 translating a high count into 'low risk' would overstate what the checklist certifies."}, {"id": "references_appraisal_jbi_prevalence", "label": "JBI prevalence checklist", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_appraisal_jbi_cross_sectional", "label": "JBI analytical cross-sectional checklist", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over JBI prevalence specifically when the study analyzes an exposure-outcome association with no temporal ordering; picking the tool by what was actually analyzed rather than the paper's self-label of 'cross-sectional' is the point of the whole tool-selection step."}, {"id": "references_appraisal_grade", "label": "GRADE \u2014 certainty of evidence per outcome", "file_type": "concept", "source_file": "references/appraisal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rated at the outcome level across the whole body of evidence, not per study, because certainty is about the estimate the review is making, not a per-paper score; a single-paper appraiser's inconsistency/publication-bias domains are explicitly overridden by Stage 7 synthesis's across-study view."}], "edges": [{"source": "references_appraisal", "target": "references_pool_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/appraisal.md", "source_location": null, "weight": 1.0}, {"source": "references_appraisal", "target": "references_appraisal_rob2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/appraisal.md", "source_location": null, "weight": 1.0}, {"source": "references_appraisal", "target": "references_appraisal_robins_i", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/appraisal.md", "source_location": null, "weight": 1.0}, {"source": "references_appraisal", "target": "references_appraisal_newcastle_ottawa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/appraisal.md", "source_location": null, "weight": 1.0}, {"source": "references_appraisal", "target": "references_appraisal_amstar2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/appraisal.md", "source_location": null, "weight": 1.0}, {"source": "references_appraisal", "target": "references_appraisal_quadas2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reference