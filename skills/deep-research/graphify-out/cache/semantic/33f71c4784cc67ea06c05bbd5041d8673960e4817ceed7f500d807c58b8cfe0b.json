{"nodes": [{"id": "references_reporting_prisma_flow", "label": "PRISMA 2020 Flow Counters", "file_type": "concept", "source_file": "references/reporting.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counter names map one-to-one onto PRISMA 2020 boxes and satisfy arithmetic invariants the verifier enforces, so the flow cannot silently fail to close."}, {"id": "references_reporting_agreement_not_kappa", "label": "Report Raw Agreement, Never Kappa-by-Assertion", "file_type": "rationale", "source_file": "references/reporting.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A kappa is reported only if actually computed from the full contingency table, named as Cohen's kappa and shown with the table; presenting raw agreement as kappa manufactures a statistic nobody computed."}, {"id": "references_reporting_citation_rules", "label": "Citation Rules R1-R6", "file_type": "concept", "source_file": "references/reporting.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A claim resting on three studies carries three footnote references, not one covering footnote; footnotes carry the appraisal verdict and evidence basis inline so abstract-only labelling survives copy-paste. Uncitable background statements are cut, not softened."}, {"id": "references_reporting_report_skeleton", "label": "Report Skeleton (16 sections)", "file_type": "concept", "source_file": "references/reporting.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each section names its data source and verify.py checks section presence; empty-with-a-stated-reason is acceptable, missing is not."}, {"id": "references_reporting_honest_statement_patterns", "label": "Honest Statement Patterns", "file_type": "rationale", "source_file": "references/reporting.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstract-only basis is labelled in three places every time (point of use, footnote, evidence table); quarantined papers are named with PMIDs rather than described as 'a small number'; preprints are tagged loudly; retracted work carries RETRACTED at every point of use."}, {"id": "references_reporting_verifier_checks", "label": "Verifier Reporting Checks (C-*)", "file_type": "concept", "source_file": "references/reporting.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any fail makes the report provisional and blocks OKF promotion, but the report is still delivered \u2014 a failed check withholds the wiki write, never the deliverable."}, {"id": "references_reporting_pre_delivery_gate", "label": "Pre-Delivery Gate", "file_type": "concept", "source_file": "references/reporting.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_okf_bundle_per_claim_attribution", "target": "references_reporting_citation_rules", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/reporting.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "references_reporting_prisma_flow", "target": "references_reporting_agreement_not_kappa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/reporting.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "references_reporting_report_skeleton", "target": "templates_report_markdown_template", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/reporting.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "references_