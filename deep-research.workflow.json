    {
      "dot": "cyan",
      "title": "Runtime contract",
      "items": [
        "Subagents write workspace files and return one-line receipts, never paper text",
        "taskboard.jsonl holds task-level state; a rerun resumes tasks, not stages",
        "Budgets per profile: max_articles 10 / 25 / 60 / 100"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence invariants",
      "items": [
        "No claim without an evidence_id actually retrieved this run",
        "Abstract-only extractions tagged and never appraised as full text",
